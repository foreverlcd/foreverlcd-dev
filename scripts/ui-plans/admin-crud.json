{
  "name": "admin-crud",
  "baseUrl": "http://localhost:3000",
  "runs": [{ "name": "desktop", "viewport": { "w": 1440, "h": 900 } }],
  "steps": [
    { "goto": "/admin/login" },
    { "fill": { "selector": "input[type=email]", "env": "ADMIN_EMAIL" } },
    { "fill": { "selector": "input[type=password]", "env": "ADMIN_PASSWORD" } },
    { "click": "button[type=submit]" },
    { "wait": 2500 },
    { "goto": "/admin/redes" },
    { "fill": { "selector": "main form >> nth=0 >> input[name=label]", "value": "E2E enlace" } },
    { "fill": { "selector": "main form >> nth=0 >> input[name=url]", "value": "https://example.test/e2e" } },
    { "click": "main form >> nth=0 >> button[type=submit]" },
    { "wait": 2000 },
    { "shot": "redes-sin-perfil" },
    { "text": "main form >> nth=0" },
    { "goto": "/admin/perfil" },
    { "fill": { "selector": "main form >> nth=0 >> input[name=fullName]", "value": "E2E Perfil" } },
    { "fill": { "selector": "main form >> nth=0 >> input[name=headline]", "value": "Titular E2E" } },
    { "fill": { "selector": "main form >> nth=0 >> textarea[name=shortBio]", "value": "Bio breve E2E" } },
    { "click": "main form >> nth=0 >> button[type=submit]" },
    { "wait": 2000 },
    { "shot": "perfil-guardado" },
    { "goto": "/admin/redes" },
    { "fill": { "selector": "main form >> nth=0 >> input[name=label]", "value": "E2E enlace" } },
    { "fill": { "selector": "main form >> nth=0 >> input[name=url]", "value": "https://example.test/e2e" } },
    { "click": "main form >> nth=0 >> button[type=submit]" },
    { "wait": 2000 },
    { "shot": "redes-creada" },
    { "text": "main" }
  ]
}
