{
  "$comment": "Subida real de la foto de perfil (Cloudinary, carpeta foreverlcd/profile) y comprobación de que guardar el perfil no la borra. Requiere ADMIN_EMAIL/ADMIN_PASSWORD de un admin local: node --env-file=.env scripts/ui-shots.mjs scripts/ui-plans/admin-photo.json. Sube un archivo a la cuenta de Cloudinary configurada.",
  "name": "admin-photo",
  "baseUrl": "http://localhost:3000",
  "runs": [{ "name": "desktop", "viewport": { "w": 1440, "h": 900 } }],
  "steps": [
    { "goto": "/admin/login" },
    { "fill": { "selector": "input[type=email]", "env": "ADMIN_EMAIL" } },
    { "fill": { "selector": "input[type=password]", "env": "ADMIN_PASSWORD" } },
    { "click": "button[type=submit]" },
    { "wait": 2500 },
    { "goto": "/admin/perfil" },
    { "expect": { "selector": "main input[name=photoUrl]", "count": 0 } },
    { "upload": { "selector": "form:has(input[type=file]) input[type=file]", "file": "scripts/ui-plans/files/test-photo.png" } },
    { "click": "form:has(input[type=file]) button" },
    { "wait": 6000 },
    { "expect": { "selector": "main [role=status]", "text": "Foto subida." } },
    { "expect": { "selector": "main img", "attr": { "name": "src", "includes": "res.cloudinary.com" } } },
    { "shot": "foto-subida" },
    { "click": "form:has(input[name=fullName]) button[type=submit]" },
    { "wait": 2500 },
    { "goto": "/admin/perfil" },
    { "expect": { "selector": "main img", "attr": { "name": "src", "includes": "foreverlcd%2Fprofile" } } },
    { "shot": "tras-guardar" }
  ]
}
