{
  "$comment": "Especificación ejecutable de docs/product/SPEC.md. Requiere la fixture (pnpm seed:fixture --yes, solo base local) y un servidor sobre esa base. Hoy muchas aserciones fallan a propósito: dependen de los siguientes exec-plans. Foto, biografía, #sobre-mi y credenciales: plan de la portada completa (#sobre-mi y #trayectoria). DESTACADO, enlaces a /stack/ y a /proyectos, 'Ver todos': plan de portada y de las páginas /proyectos y /stack. /proyectos/<slug> (repositorios, galería, fechas): plan de la ficha de proyecto. /stack/<slug>: plan de la página de stack. Los 404 de borrador ya deberían cumplirse. Textos de marcador: scripts/seed-fixture.ts.",
  "name": "coverage",
  "baseUrl": "http://localhost:3000",
  "runs": [{ "name": "desktop", "viewport": { "w": 1440, "h": 900 } }],
  "steps": [
    { "goto": "/" },
    { "wait": 1000 },
    { "expect": { "selector": "#inicio", "text": "Ada Valentina Ríos Mendoza (ficticio)" } },
    { "expect": { "selector": "#inicio", "text": "Lima, Perú (ficticio)" } },
    { "expect": { "selector": "#sobre-mi img", "attr": { "name": "src", "includes": "res.cloudinary.com" } } },
    { "expect": { "selector": "#sobre-mi", "text": "Biografía larga de marcador" } },
    { "expect": { "selector": "#sobre-mi", "text": "ada.rios@example.com" } },
    { "expect": { "selector": "#sobre-mi a[href='https://example.com/ada/github']", "min": 1 } },
    { "expect": { "selector": "#proyectos", "text": "DESTACADO" } },
    { "expect": { "selector": "#proyectos", "text": "Proyecto Aurora (ficticio)" } },
    { "expect": { "selector": "#proyectos", "text": "Proyecto Boreal (ficticio)" } },
    { "expect": { "selector": "#proyectos", "text": "Proyecto Cénit (ficticio)", "count": 0 } },
    { "expect": { "selector": "#proyectos img", "attr": { "name": "src", "includes": "res.cloudinary.com" } } },
    { "expect": { "selector": "#proyectos a[href='https://example.com/aurora']", "min": 1 } },
    { "expect": { "selector": "#proyectos a[href*='/stack/']", "min": 1 } },
    { "expect": { "selector": "#proyectos a[href='/proyectos']", "min": 1 } },
    { "expect": { "selector": "#proyectos", "text": "Ver todos los proyectos (4)" } },
    { "expect": { "selector": "body", "text": "Proyecto Borrador Oculto", "count": 0 } },
    { "expect": { "selector": "#trayectoria", "text": "Ingeniera Backend Senior (ficticio)" } },
    { "expect": { "selector": "#trayectoria", "text": "actual" } },
    { "expect": { "selector": "#trayectoria", "text": "Freelance" } },
    { "expect": { "selector": "#trayectoria", "text": "Certificación" } },
    { "expect": { "selector": "#trayectoria", "text": "Ver credencial" } },
    { "expect": { "selector": "#trayectoria a[href='https://example.com/ada/credencial']", "min": 1 } },
    { "expect": { "selector": "#trayectoria", "text": "Empresa Inactiva Oculta", "count": 0 } },
    { "expect": { "selector": "#stack", "text": "Backend y datos" } },
    { "expect": { "selector": "#stack", "text": "Categoría de marcador: servicios" } },
    { "expect": { "selector": "#stack img[src*='res.cloudinary.com']", "min": 1 } },
    { "expect": { "selector": "#stack a[href='/stack/typescript']", "min": 1 } },
    { "expect": { "selector": "#contacto", "text": "ada.rios@example.com" } },
    { "expect": { "selector": "#contacto a[href='https://example.com/ada/linkedin']", "min": 1 } },

    { "goto": "/proyectos" },
    { "expect": { "selector": "main", "text": "Proyecto Cénit (ficticio)" } },
    { "expect": { "selector": "main", "text": "Proyecto Delta (ficticio)" } },
    { "expect": { "selector": "main img[src*='res.cloudinary.com']", "min": 4 } },
    { "expect": { "selector": "main", "text": "Proyecto Borrador Oculto", "count": 0 } },

    { "goto": "/proyectos/fixture-aurora" },
    { "expect": { "selector": "main", "text": "Descripción larga de marcador de Aurora" } },
    { "expect": { "selector": "main", "text": "Backend" } },
    { "expect": { "selector": "main", "text": "Frontend" } },
    { "expect": { "selector": "main", "text": "Código" } },
    { "expect": { "selector": "main a[href='https://example.com/ada/aurora-api']", "min": 1 } },
    { "expect": { "selector": "main a[href='https://example.com/aurora']", "min": 1 } },
    { "expect": { "selector": "main img[src*='res.cloudinary.com']", "min": 3 } },
    { "expect": { "selector": "main", "text": "febrero 2023" } },
    { "expect": { "selector": "main a[href='/stack/typescript']", "min": 1 } },

    { "goto": "/stack/typescript" },
    { "expect": { "selector": "main", "text": "Descripción de marcador de TypeScript" } },
    { "expect": { "selector": "main", "text": "Backend y datos" } },
    { "expect": { "selector": "main", "text": "Proyecto Aurora (ficticio)" } },
    { "expect": { "selector": "main", "text": "Proyecto Delta (ficticio)" } },
    { "expect": { "selector": "main", "text": "Proyecto Boreal (ficticio)", "count": 0 } },

    { "expectStatus": { "path": "/proyectos/fixture-borrador", "status": 404 } },
    { "expectStatus": { "path": "/proyectos/no-existe", "status": 404 } },
    { "expectStatus": { "path": "/stack/no-existe", "status": 404 } }
  ]
}
